{{ define "user_form.tmpl" }}
<!doctype html>
<html lang="en"><head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Create personnel</title>
		<link rel="stylesheet" href="/static/site.css">
	</head>
	<body>{{ template "portal_nav" . }}<main>
			<header>
				<p class="eyebrow">Administration</p>
				<h1>Create personnel account</h1>
			</header>
			<section class="panel narrow">
				<form method="post" action="/admin/users">
					<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
					<label>First name<input name="first_name" required maxlength="100"></label>
					<label>Last name<input name="last_name" required maxlength="100">
					</label>
					<label>Email<input type="email" name="email" required maxlength="254"></label>
					<label>Role<select name="role"><option value="employee">Employee</option>
							<option value="admin">Administrator</option>
						</select>
					</label>
					<label>Initial password<input type="password" name="password" minlength="12" maxlength="72" required>
					</label>
					<p class="muted">12–72 characters with uppercase, lowercase and a number.</p>
					<button>Create account</button>
				</form>
			</section>
		</main>
	</body>
</html>
{{ end }}
