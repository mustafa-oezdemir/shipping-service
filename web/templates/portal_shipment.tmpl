{{ define "portal_shipment.tmpl" }}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>{{ .Shipment.TrackingNumber }}</title>
		<link rel="stylesheet" href="/static/site.css">
	</head>
	<body>{{ template "portal_nav" . }}<main>
			<header>
				<p class="eyebrow">Shipment</p>
				<h1>{{ .Shipment.TrackingNumber }}</h1>
				<span class="badge">{{ .Shipment.Status }}</span>
			</header>
			<div class="grid">
				<section class="panel">
					<h2>Recipient</h2>
					<p>{{ .Shipment.Recipient.FirstName }} {{ .Shipment.Recipient.LastName }}<br>{{ .Shipment.Recipient.Street }} {{ .Shipment.Recipient.HouseNumber }}<br>{{ .Shipment.Recipient.PostalCode }} {{ .Shipment.Recipient.City }}<br>{{ .Shipment.Recipient.CountryCode }}</p>
					<p>
						<strong>Order:</strong>
						{{ .Shipment.ExternalOrderID }}
					</p>
				</section>
				<section class="panel">
					<h2>Available actions</h2>
					{{ range .NextStatuses }}
						<form method="post" action="/shipments/{{ $.Shipment.PublicID }}/status">
							<input type="hidden" name="csrf_token" value="{{ $.CSRF }}">
							<input type="hidden" name="numeric_id" value="{{ $.Shipment.ID }}">
							<input type="hidden" name="expected_status" value="{{ $.Shipment.Status }}">
							<input type="hidden" name="status" value="{{ . }}"><button type="submit">Mark as {{ . }}</button>
						</form>
					{{ else }}<p>No state transition is currently available.</p>
					{{ end }}
					{{ if eq .Shipment.Status "out_for_delivery" }}
						<form method="post" action="/shipments/{{ .Shipment.PublicID }}/stops">
							<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
							<label>Remaining stops
								<input type="number" min="0" max="500" name="remaining_stops" required>
							</label>
							<button>Update stops</button>
						</form>
					{{ end }}
				</section>
			</div>
			<section class="panel">
				<h2>Timeline</h2>
				<ol class="timeline">
					{{ range .Shipment.Events }}<li>
							<time>{{ .OccurredAt.Format "02 Jan 2006 15:04" }}</time>
							<strong>{{ .Title }}</strong>
							<span>{{ .Description }}</span>
						</li>
					{{ else }}
						<li>No events.</li>
					{{ end }}
				</ol>
			</section>
		</main>
	</body>
</html>
{{ end }}
