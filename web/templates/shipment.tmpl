{{ define "shipment.tmpl" }}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ .Shipment.TrackingNumber }}</title><link rel="stylesheet" href="/static/site.css"></head>
	<body>
		<main>
			<h1>{{ .Shipment.TrackingNumber }}</h1>
			<p>Status: <strong>{{ .Shipment.Status }}</strong></p>
			<section>
				<h2>Recipient</h2>
				<p>{{ .Shipment.Recipient.FirstName }} {{ .Shipment.Recipient.LastName }}<br>{{ .Shipment.Recipient.Street }} {{ .Shipment.Recipient.HouseNumber }}<br>{{ .Shipment.Recipient.PostalCode }} {{ .Shipment.Recipient.City }}<br>{{ .Shipment.Recipient.CountryCode }}</p>
			</section>
			<section>
				<h2>Sender</h2>
				<p>{{ .Shipment.Sender.Company }}<br>{{ .Shipment.Sender.Street }} {{ .Shipment.Sender.HouseNumber }}<br>{{ .Shipment.Sender.PostalCode }} {{ .Shipment.Sender.City }}</p></section><p>
				<a href="/shipments/{{ .Shipment.ID }}/label">Print label</a>
			</p><h2>Events</h2><ol>{{ range .Shipment.Events }}<li>{{ .OccurredAt.Format "02 Jan 2006 15:04" }} — {{ .Title }}</li>{{ end }}</ol>
		</main>
	</body>
</html>
{{ end }}
