{{ define "portal_nav" }}
<nav>
	<a class="brand" href="/dashboard">Pehlione Shipping</a>
	<div>
		<a href="/dashboard">Dashboard</a>
		<a href="/shipments">Shipments</a>
		<a href="/scan">QR Scanner</a>
		<a href="/returns">Returns</a>
		{{ if eq .User.Role "admin" }}
			<a href="/admin/dashboard">Admin</a>
			<a href="/admin/users">Users</a>
			<a href="/admin/audit">Audit</a>
		{{ end }}
		<details class="profile-menu">
			<summary aria-label="Open profile menu">
				<span>{{ .User.FirstName }} {{ .User.LastName }}</span>
				<span class="badge">{{ .User.Role }}</span>
				<span class="profile-menu-chevron" aria-hidden="true"></span>
			</summary>
			<div class="profile-dropdown">
				<a href="/profile">Profile</a>
				<form method="post" action="/logout">
					<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
					<button class="dropdown-action" type="submit">Logout</button>
				</form>
			</div>
		</details>
	</div>
</nav>
{{ end }}
{{ define "public_nav" }}
<nav class="public-nav" aria-label="Primary navigation">
	<a class="brand" href="/">PehliOne Shipping</a>
	<div>
		<a href="#tracking-summary">Track Shipment</a>
		<a href="/">Home</a>
		<a class="nav-login" href="/login">Login</a>
	</div>
</nav>
{{ end }}
{{ define "activity_table" }}<table>
	<thead>
		<tr>
			<th>Time</th>
			<th>Action</th>
			<th>Entity</th>
		</tr>
	</thead>
	<tbody>
		{{ range . }}
			<tr>
				<td>{{ .CreatedAt.Format "02 Jan 15:04" }}</td>
				<td>{{ .Action }}</td>
				<td>
					{{ .EntityType }} {{ .EntityID }}</td>
			</tr>
		{{ else }}
			<tr>
				<td colspan="3">No recent activity.</td>
			</tr>
		{{ end }}
	</tbody>
</table>
{{ end }}
