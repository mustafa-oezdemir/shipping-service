{{ define "scan.tmpl" }}
<!doctype html><html lang="en">
	<head><meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>QR Scanner</title>
		<link rel="stylesheet" href="/static/site.css">
<script src="/static/scan.js" defer></script>
	</head>
	<body>{{ template "portal_nav" . }}<main>
			<header><p class="eyebrow">Secure personnel operation</p>
				<h1>Scan shipment QR</h1>
				<p>Camera access requires HTTPS in production.</p>
			</header>
			<section class="panel scan">
				<video id="scanner" playsinline></video>
				<div id="scan-status" class="muted">Use camera or enter the tracking number.</div>
				{{ if .Error }}<div class="alert">{{ .Error }}
					</div>
				{{ end }}
				<form method="post" action="/scan" id="scan-form">
					<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
					<label>Tracking number or shipment ID<input name="tracking_number" id="tracking-number" required></label>
					<button type="submit">Find shipment</button>
				</form>
				<button type="button" id="start-scan" class="secondary">Start camera</button>
			</section>
		</main>
	</body>
</html>
{{ end }}
