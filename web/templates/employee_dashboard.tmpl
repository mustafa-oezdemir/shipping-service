{{ define "employee_dashboard.tmpl" }}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Dashboard</title><link rel="stylesheet" href="/static/site.css"></head><body>{{template "portal_nav" .}}<main><header><p class="eyebrow">Shipping operations</p><h1>My Dashboard</h1><p>Welcome back, {{.User.FirstName}}.</p></header><section class="stats"><article><strong>{{index .Counts "handed_over"}}</strong><span>Waiting for receipt</span></article><article><strong>{{index .Counts "received_at_origin"}}</strong><span>Received</span></article><article><strong>{{index .Counts "sorting"}}</strong><span>Sorting queue</span></article><article><strong>{{index .Counts "in_transit"}}</strong><span>In transit</span></article><article><strong>{{index .Counts "delivery_failed"}}</strong><span>Failures</span></article><article><strong>{{index .Counts "return_requested"}}</strong><span>Returns waiting</span></article></section><section class="panel"><h2>My recent activity</h2>{{template "activity_table" .Recent}}</section></main></body></html>{{end}}
