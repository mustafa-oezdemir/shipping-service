{{define "user_detail.tmpl"}}<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.ManagedUser.FirstName}} {{.ManagedUser.LastName}}</title><link rel="stylesheet" href="/static/site.css"></head><body>{{template "portal_nav" .}}<main><header><p class="eyebrow">Personnel profile</p><h1>{{.ManagedUser.FirstName}} {{.ManagedUser.LastName}}</h1><span class="badge">{{.ManagedUser.Role}}</span> {{if .ManagedUser.IsActive}}Active{{else}}Inactive{{end}}</header><div class="grid"><section class="panel"><h2>Profile</h2><form method="post" action="/admin/users/{{.ManagedUser.ID}}"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>First name<input name="first_name" value="{{.ManagedUser.FirstName}}" required></label><label>Last name<input name="last_name" value="{{.ManagedUser.LastName}}" required></label><label>Email<input value="{{.ManagedUser.Email}}" disabled></label><button>Save</button></form><form method="post" action="/admin/users/{{.ManagedUser.ID}}/role"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><label>Role<select name="role"><option value="employee">Employee</option><option value="admin">Administrator</option></select></label><button>Change role</button></form><form method="post" action="/admin/users/{{.ManagedUser.ID}}/status"><input type="hidden" name="csrf_token" value="{{.CSRF}}"><input type="hidden" name="active" value="{{if .ManagedUser.IsActive}}false{{else}}true{{end}}"><button class="danger">{{if .ManagedUser.IsActive}}Disable account{{else}}Enable account{{end}}</button></form></section><section class="panel"><h2>Recent activity</h2>{{template "activity_table" .Recent}}</section></div></main></body></html>{{end}}
