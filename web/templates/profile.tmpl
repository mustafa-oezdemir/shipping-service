{{ define "profile.tmpl" }}
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>My Profile</title>
		<link rel="stylesheet" href="/static/site.css">
	</head>
	<body>{{ template "portal_nav" . }}<main>
			<header>
				<p class="eyebrow">Personnel account</p>
				<h1>My Profile</h1>
			</header>
			<div class="grid">
				<section class="panel">
					<div class="profile-head">
						{{ if .User.ProfileImageFilename }}
							<img class="avatar" src="/profile/images/{{ .User.ProfileImageFilename }}" alt="Profile image">
						{{ else }}
							<div class="avatar initials">{{ .User.Initials }}
							</div>
						{{ end }}<div>
							<h2>{{ .User.FirstName }} {{ .User.LastName }}</h2>
							<span class="badge">{{ .User.Role }}</span>
							<p>{{ .User.Email }}</p>
						</div>
					</div>
					<form method="post" action="/profile">
						<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
						<label>First name
							<input name="first_name" value="{{ .User.FirstName }}" required maxlength="100"></label>
						<label>Last name
							<input name="last_name" value="{{ .User.LastName }}" required maxlength="100">
						</label>
						<label>Email
							<input value="{{ .User.Email }}" disabled>
						</label><button>Save profile</button>
					</form>
					<form method="post" action="/profile/image" enctype="multipart/form-data">
						<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
						<label>Profile image (JPEG, PNG or WEBP; max 3 MiB)
							<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required>
						</label>
						<button>Upload image</button>
					</form>
					{{ if .User.ProfileImageFilename }}
						<form method="post" action="/profile/image/delete">
							<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
							<button class="danger">Remove image</button>
						</form>
					{{ end }}</section>
				<section class="panel">
					<h2>Change password</h2>
					{{ if .PasswordError }}
						<div class="alert">{{ .PasswordError }}</div>
					{{ end }}
					<form method="post" action="/profile/password">
						<input type="hidden" name="csrf_token" value="{{ .CSRF }}">
						<label>Current password
							<input type="password" name="current_password" autocomplete="current-password" required>
						</label>
						<label>New password
							<input type="password" name="new_password" autocomplete="new-password" minlength="12" maxlength="72" required>
						</label>
						<label>Confirm new password
							<input type="password" name="confirm_password" autocomplete="new-password" required>
						</label>
						<p class="muted">12–72 characters with uppercase, lowercase and a number.</p>
						<button>Update password</button>
					</form>
				</section>
			</div>
		</main>
	</body>
</html>
{{ end }}
