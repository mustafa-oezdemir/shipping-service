DATABASE_DSN=shipping:change_me@tcp(127.0.0.1:3308)/shipping?charset=utf8mb4&parseTime=True&loc=UTC
DATABASE_CONNECT_TIMEOUT=30s
ECOMMERCE_TO_SHIPPING_TOKEN=replace-with-at-least-32-random-characters
ECOMMERCE_TO_SHIPPING_PREVIOUS_TOKEN=
