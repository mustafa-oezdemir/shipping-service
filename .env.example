APP_ENV=development
APP_PORT=8090
METRICS_PORT=9092
APP_URL=http://localhost:8090
GIN_MODE=debug
TRUSTED_PROXIES=
SHIPPING_HOST_PORT=8090
# Optional explicit overrides. Docker uses DATABASE_DSN_DOCKER first.
DATABASE_DSN=
DATABASE_DSN_DOCKER=
DATABASE_CONNECT_TIMEOUT=30s
ECOMMERCE_TO_SHIPPING_TOKEN=replace-with-at-least-32-random-characters
ECOMMERCE_TO_SHIPPING_PREVIOUS_TOKEN=
# Private Docker service address. A host-run process may override ecommerce-app with localhost.
ECOMMERCE_API_URL=http://ecommerce-app:8080
# Optional exact callback override; when empty it is derived from ECOMMERCE_API_URL.
ECOMMERCE_CALLBACK_URL=
# Browser-reachable E-Commerce origin; never use the private Docker hostname here.
ECOMMERCE_PUBLIC_URL=http://localhost:8080
SHIPPING_TO_ECOMMERCE_TOKEN=replace-with-a-different-32-character-random-token
INTERNAL_QR_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-different-32-character-random-secret
SESSION_TTL=12h
PROFILE_IMAGE_DIRECTORY=./data/profile-images
# Optional one-time bootstrap. Remove these after the first successful startup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Shipping
INITIAL_ADMIN_LAST_NAME=Administrator
# Deprecated compatibility alias; APP_URL is authoritative.
PUBLIC_BASE_URL=
OUTBOX_POLL_INTERVAL=5s
OUTBOX_RETRY_BASE_DELAY=30s
OUTBOX_PROCESSING_STALE_AFTER=2m
OUTBOX_MAX_ATTEMPTS=8
REQUEST_TIMEOUT=10s

WAREHOUSE_NAME=PehliOne Logistics Center
WAREHOUSE_COMPANY=PehliOne GmbH
WAREHOUSE_STREET=Musterstrasse
WAREHOUSE_HOUSE_NUMBER=10
WAREHOUSE_POSTAL_CODE=35039
WAREHOUSE_CITY=Marburg
WAREHOUSE_COUNTRY=DE

MYSQL_HOST=127.0.0.1
MYSQL_PORT=
SHIPPING_DB_HOST_PORT=3308
MYSQL_DATABASE=pehlione-shipping
MYSQL_USER=pehlione-shipping
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
