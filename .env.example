PUBLIC_BASE_URL=
OUTBOX_POLL_INTERVAL=5s
OUTBOX_RETRY_BASE_DELAY=30s
OUTBOX_PROCESSING_STALE_AFTER=2m
OUTBOX_MAX_ATTEMPTS=8
REQUEST_TIMEOUT=10s

WAREHOUSE_NAME=NordShop Logistics Center
WAREHOUSE_COMPANY=NordShop GmbH
